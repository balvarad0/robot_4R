<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rrrr">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rrrr urdf file -->
    <xacro:include filename="$(find rrrr)/urdf/rrrr.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="rrrr.ros2_control.xacro" />


    <xacro:rrrr_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
